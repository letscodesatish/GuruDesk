{
  "experimentalServices": {
    "web": {
      "entrypoint": "frontend",
      "routePrefix": "/",
      "framework": "nextjs"
    },
    "api": {
      "entrypoint": "backend/app/main.py",
      "routePrefix": "/api",
      "framework": "fastapi"
    }
  },
  "functions": {
    "backend/app/main.py": {
      "maxDuration": 60
    }
  }
}